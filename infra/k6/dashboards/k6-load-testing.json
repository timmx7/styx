{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Styx — k6 Load Test Results (real-time)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Request Rate",
      "type": "stat",
      "targets": [{ "expr": "rate(k6_http_reqs_total[30s])", "legendFormat": "req/s" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "p95 Latency",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, rate(k6_http_req_duration_seconds_bucket[30s])) * 1000", "legendFormat": "p95" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Error Rate",
      "type": "stat",
      "targets": [{ "expr": "rate(k6_http_req_failed_total[30s]) / rate(k6_http_reqs_total[30s])", "legendFormat": "errors" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active VUs",
      "type": "stat",
      "targets": [{ "expr": "k6_vus", "legendFormat": "VUs" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Total Requests",
      "type": "stat",
      "targets": [{ "expr": "k6_http_reqs_total", "legendFormat": "total" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "red", "value": 0.90 }] },
          "unit": "percentunit",
          "max": 1
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Check Pass Rate",
      "type": "stat",
      "targets": [{ "expr": "k6_checks_rate", "legendFormat": "checks" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Latency Analysis",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "gradientMode": "scheme" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 7 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] }, "tooltip": { "mode": "multi" } },
      "title": "Request Duration Percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(k6_http_req_duration_seconds_bucket[30s])) * 1000", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, rate(k6_http_req_duration_seconds_bucket[30s])) * 1000", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.95, rate(k6_http_req_duration_seconds_bucket[30s])) * 1000", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(k6_http_req_duration_seconds_bucket[30s])) * 1000", "legendFormat": "p99" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "stacking": { "mode": "normal" } },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 7 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "Request Rate by Status",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(k6_http_reqs_total{expected_response=\"true\"}[30s])", "legendFormat": "Success" },
        { "expr": "rate(k6_http_reqs_total{expected_response=\"false\"}[30s])", "legendFormat": "Failed" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 102,
      "title": "VUs & Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 20,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "Virtual Users",
      "type": "timeseries",
      "targets": [
        { "expr": "k6_vus", "legendFormat": "Active VUs" },
        { "expr": "k6_vus_max", "legendFormat": "Max VUs" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 21,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "Data Transfer",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(k6_data_received_total[30s])", "legendFormat": "Received" },
        { "expr": "rate(k6_data_sent_total[30s])", "legendFormat": "Sent" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 103,
      "title": "HTTP Details",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 30,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "HTTP Timing Breakdown",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(k6_http_req_connecting_sum[30s]) / rate(k6_http_req_connecting_count[30s]) * 1000", "legendFormat": "Connecting" },
        { "expr": "rate(k6_http_req_tls_handshaking_sum[30s]) / rate(k6_http_req_tls_handshaking_count[30s]) * 1000", "legendFormat": "TLS Handshake" },
        { "expr": "rate(k6_http_req_waiting_sum[30s]) / rate(k6_http_req_waiting_count[30s]) * 1000", "legendFormat": "Waiting (TTFB)" },
        { "expr": "rate(k6_http_req_receiving_sum[30s]) / rate(k6_http_req_receiving_count[30s]) * 1000", "legendFormat": "Receiving" },
        { "expr": "rate(k6_http_req_sending_sum[30s]) / rate(k6_http_req_sending_count[30s]) * 1000", "legendFormat": "Sending" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 31,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "title": "Iterations & Checks",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(k6_iterations_total[30s])", "legendFormat": "Iterations/s" },
        { "expr": "rate(k6_checks_total{status=\"pass\"}[30s])", "legendFormat": "Checks Passed/s" },
        { "expr": "rate(k6_checks_total{status=\"fail\"}[30s])", "legendFormat": "Checks Failed/s" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 104,
      "title": "Styx Custom Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "green", "value": 0.5 }] },
          "unit": "percentunit",
          "max": 1
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 36 },
      "id": 40,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true, "showThresholdLabels": false },
      "title": "Cache Hit Rate",
      "type": "gauge",
      "targets": [{ "expr": "k6_styx_cache_hit_rate", "legendFormat": "hit rate" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 36 },
      "id": 41,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["mean"] } },
      "title": "Router Overhead (avg)",
      "type": "stat",
      "targets": [{ "expr": "k6_styx_router_overhead_ms", "legendFormat": "overhead" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 36 },
      "id": 42,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Error Breakdown",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(k6_styx_auth_errors_total[1m])", "legendFormat": "Auth (401)" },
        { "expr": "rate(k6_styx_ratelimit_hits_total[1m])", "legendFormat": "Rate Limit (429)" },
        { "expr": "rate(k6_styx_budget_errors_total[1m])", "legendFormat": "Budget (429)" },
        { "expr": "rate(k6_styx_fallback_count_total[1m])", "legendFormat": "Fallbacks" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["styx", "k6", "load-testing", "performance"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
