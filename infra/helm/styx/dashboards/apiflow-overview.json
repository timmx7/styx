    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "id": 41,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "Error Rate Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(styx_requests_total{status=~\"5..\"}[5m])) / sum(rate(styx_requests_total[5m]))",
          "legendFormat": "5xx error rate"
        },
        {
          "expr": "sum(rate(styx_requests_total{status=~\"4..\"}[5m])) / sum(rate(styx_requests_total[5m]))",
          "legendFormat": "4xx error rate"
        }
      ]
