# ═══════════════════════════════════════════════════════════════
# Styx Backend — Environment Variables
# Copy to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://styx:styx@postgres:5432/styx

# ── Auth & Security ───────────────────────────────────────────
JWT_SECRET=                        # openssl rand -hex 32
INTERNAL_SECRET=                   # Service-to-service auth secret
API_KEY_HMAC_SECRET=               # HMAC key for API key hashing
ENCRYPTION_KEY=                    # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Redis (cache, rate limits, lockout counters) ──────────────
REDIS_URL=redis://redis:6379/0

# ── ClickHouse (analytics, optional) ─────────────────────────
CLICKHOUSE_URL=http://clickhouse:8123

# ── Stripe Billing ────────────────────────────────────────────
STRIPE_SECRET_KEY=                 # sk_test_xxx or sk_live_xxx
STRIPE_WEBHOOK_SECRET=             # whsec_xxx (from Stripe Dashboard)

# Stripe Price IDs — run: python scripts/stripe_setup.py
STRIPE_PRICE_CHARON_SHADE=
STRIPE_PRICE_CHARON_OBOL=
STRIPE_PRICE_CHARON_FERRYMAN=
STRIPE_PRICE_CHARON_TITAN=
STRIPE_PRICE_ACHILLES_SPARK=
STRIPE_PRICE_ACHILLES_BLAZE=
STRIPE_PRICE_ACHILLES_INFERNO=

# ── Provider API Keys (at least one required) ─────────────────
# Used only in Achilles mode (managed keys). In Charon mode,
# clients bring their own keys via X-Provider-Key header.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# ── Email (optional — disabled if empty) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@styx.ai

# ── GitHub OAuth (optional) ───────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Frontend URL (for email links, OAuth redirects) ───────────
FRONTEND_URL=http://localhost:3000

# ── Monitoring ────────────────────────────────────────────────
SENTRY_DSN=                        # https://xxx@sentry.io/xxx
ENVIRONMENT=development            # development | staging | production

# ── Debug ─────────────────────────────────────────────────────
DEBUG=true
