# ═══════════════════════════════════════════════════════════════
# Styx Dashboard — Environment Variables
# Copy to .env.local and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ── Backend API URL ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Router proxy URL (for code snippets in the dashboard) ────
NEXT_PUBLIC_ROUTER_URL=http://localhost:8080

# ── Supabase Auth ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=              # e.g. https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Supabase anon/public key

# ── Sentry (error monitoring, optional) ──────────────────────
NEXT_PUBLIC_SENTRY_DSN=            # Client-side DSN
SENTRY_DSN=                        # Server-side DSN (same value)
SENTRY_AUTH_TOKEN=                 # For source map uploads (optional)
